# ==========================================
# Root GitIgnore configuration
# Ai Powered Campus Connect Platform
# ==========================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDEs and Editors
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
.factorypath

# Environment & Secrets (NEVER commit credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Java & Backend Ignore Rules
# ==========================================
backend/target/
backend/*.jar
backend/*.war
backend/*.ear
backend/out/
backend/.mvn/wrapper/maven-wrapper.jar

# Spring Boot & Database temporary files
backend/*.h2.db
backend/crash.log

# ==========================================
# Node.js & Frontend Ignore Rules
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
frontend/.cache/
frontend/.parcel-cache/
frontend/.eslintcache
frontend/.vite/

# Temporary / Scratch Files
scratch/
tmp/
*.tmp
